    {
      "id": "EAzhC8nmJSjrPhugKzp9E",
      "type": "text",
      "x": 1170.1372911345616,
      "y": 774.6445117275935,
      "width": 1012,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5o",
      "roundness": null,
      "seed": 1582338872,
      "version": 339,
      "versionNonce": 1024308024,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760620744507,
      "link": null,
      "locked": false,
      "text": "void        get_texture_x(...)\n{\n        if (side == S || side == N)\n                tex_x = (mod(ray.hit_pos.x, TILE_SIZE)) * texture[side]->width / TILE_SIZE;\n        else if (side == W || side == E)\n                tex_x = (fmod(ray.hit_pos.y, TILE_SIZE)) * texture[side]->width / TILE_SIZE;\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void        get_texture_x(...)\n{\n        if (side == S || side == N)\n                tex_x = (mod(ray.hit_pos.x, TILE_SIZE)) * texture[side]->width / TILE_SIZE;\n        else if (side == W || side == E)\n                tex_x = (fmod(ray.hit_pos.y, TILE_SIZE)) * texture[side]->width / TILE_SIZE;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uZ1HXQ3Jnr3w-Hf6LL0BV",
      "type": "text",
      "x": 52.08402962122916,
      "y": 178.08788518571498,
      "width": 495,
      "height": 25,
      "angle": 0,
