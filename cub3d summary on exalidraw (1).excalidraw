      "isDeleted": false,
      "boundElements": null,
      "updated": 1760620715785,
      "link": null,
      "locked": false,
      "text": "function        render_ceiling_floor(int end, int color)\n{\n        while (y_on_screen < end)\n        {\n                mlx_put_pixel(img, x_on_screen, y_on_screen, color);\n                y_on_screen++;\n        }\n}\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function        render_ceiling_floor(int end, int color)\n{\n        while (y_on_screen < end)\n        {\n                mlx_put_pixel(img, x_on_screen, y_on_screen, color);\n                y_on_screen++;\n        }\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JCAJqQvTNGHqVBm4Oujf1",
      "type": "text",
      "x": 1167.5631464785743,
      "y": 1520.2099148647126,
      "width": 913,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5oj",
      "roundness": null,
      "seed": 1643452488,
      "version": 998,
      "versionNonce": 1061731384,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760622967084,
      "link": null,
      "locked": false,
      "text": "function        render_walls(...)\n{\n        int           tex_pos_on_wall;\n        int           color;\n        mlx_image_t   *texture;\n\n        tex_pos_on_wall = (wall_h - HEIGHT) / 2;\n        while (y_on_screen < HEIGHT - (margen / 2))\n        {\n                tex_y = (y_on_screen + tex_pos_on_wall) * texture->height / wall_h;\n                color = get_pixel_color(texture, tex_x, tex_y);\n                mlx_put_pixel(img, x_on_screen, y_on_screen, color);\n                a->y_on_screen++;\n        }\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function        render_walls(...)\n{\n        int           tex_pos_on_wall;\n        int           color;\n        mlx_image_t   *texture;\n\n        tex_pos_on_wall = (wall_h - HEIGHT) / 2;\n        while (y_on_screen < HEIGHT - (margen / 2))\n        {\n                tex_y = (y_on_screen + tex_pos_on_wall) * texture->height / wall_h;\n                color = get_pixel_color(texture, tex_x, tex_y);\n                mlx_put_pixel(img, x_on_screen, y_on_screen, color);\n                a->y_on_screen++;\n        }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
