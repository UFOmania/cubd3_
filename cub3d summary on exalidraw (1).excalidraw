    },
    {
      "id": "uUheZ896MCeKbOLPxzA8v",
      "type": "text",
      "x": 61.32323472256761,
      "y": 757.7372925957221,
      "width": 539,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5od",
      "roundness": null,
      "seed": 1882370632,
      "version": 632,
      "versionNonce": 417654600,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760620764295,
      "link": null,
      "locked": false,
      "text": "void        get_wall_height_and_margen(...)\n{\n        int        wall_hight;\n        int        margen;\n\n        wall_hight = (TILE_SIZE * ppd) / ray.len;\n        \n        margen = 0;\n        if (wall_hight < HEIGHT)\n                margen = HEIGHT - wall_hight;\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "void        get_wall_height_and_margen(...)\n{\n        int        wall_hight;\n        int        margen;\n\n        wall_hight = (TILE_SIZE * ppd) / ray.len;\n        \n        margen = 0;\n        if (wall_hight < HEIGHT)\n                margen = HEIGHT - wall_hight;\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "T7v4WI4GC3QpU2e0OMiZZ",
      "type": "text",
      "x": 2354.442671776452,
      "y": 263.7703203862173,
      "width": 1001,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5of",
      "roundness": null,
      "seed": 1575850312,
      "version": 732,
      "versionNonce": 270155336,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760632093155,
      "link": null,
      "locked": false,
      "text": "t_vec2        get_v_intercept(t_vec2 pos, double angle)\n{\n        t_vec2        v_intercept;\n\n        v_intercept = (t_vec2){INFINITY, INFINITY};\n        if (fabs(cos(angle)) > 0.0000001)\n        {\n                if (cos(angle) > 0)\n                        v_intercept.x = (floor(pos.x / TILE_SIZE) * TILE_SIZE) + TILE_SIZE;\n                else\n                        v_intercept.x = floor(pos.x / TILE_SIZE) * TILE_SIZE - 0.00001;\n                v_intercept.y = pos.y + ((v_intercept.x - pos.x) * tan(angle));\n        }\n        return (v_intercept);\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "t_vec2        get_v_intercept(t_vec2 pos, double angle)\n{\n        t_vec2        v_intercept;\n\n        v_intercept = (t_vec2){INFINITY, INFINITY};\n        if (fabs(cos(angle)) > 0.0000001)\n        {\n                if (cos(angle) > 0)\n                        v_intercept.x = (floor(pos.x / TILE_SIZE) * TILE_SIZE) + TILE_SIZE;\n                else\n                        v_intercept.x = floor(pos.x / TILE_SIZE) * TILE_SIZE - 0.00001;\n                v_intercept.y = pos.y + ((v_intercept.x - pos.x) * tan(angle));\n        }\n        return (v_intercept);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Cv9rm7tVx0T_FnfnBG-ZS",
      "type": "text",
      "x": 3410.8305126114633,
      "y": 249.1449111292713,
      "width": 1001,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5og",
      "roundness": null,
      "seed": 1065761336,
      "version": 810,
      "versionNonce": 1673466680,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760633144955,
      "link": null,
      "locked": false,
      "text": "t_vec2        get_h_intercept(t_vec2 pos, double angle)\n{\n        t_vec2        h_intercept;\n\n        h_intercept = (t_vec2){INFINITY, INFINITY};\n        if (fabs(sin(angle)) > 0.0000001)\n        {\n                if (sin(angle) > 0)\n                        h_intercept.y = (floor(pos.y / TILE_SIZE) * TILE_SIZE) + TILE_SIZE;\n                else\n                        h_intercept.y = floor(pos.y / TILE_SIZE) * TILE_SIZE - 0.00001;\n                h_intercept.x = pos.x + ((h_intercept.y - pos.y) / tan(angle));\n        }\n        return (h_intercept);\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "t_vec2        get_h_intercept(t_vec2 pos, double angle)\n{\n        t_vec2        h_intercept;\n\n        h_intercept = (t_vec2){INFINITY, INFINITY};\n        if (fabs(sin(angle)) > 0.0000001)\n        {\n                if (sin(angle) > 0)\n                        h_intercept.y = (floor(pos.y / TILE_SIZE) * TILE_SIZE) + TILE_SIZE;\n                else\n                        h_intercept.y = floor(pos.y / TILE_SIZE) * TILE_SIZE - 0.00001;\n                h_intercept.x = pos.x + ((h_intercept.y - pos.y) / tan(angle));\n        }\n        return (h_intercept);\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FQ5qex_xxqzvxy96-FXa2",
      "type": "text",
      "x": 1164.6580657251136,
      "y": 173.31992752898952,
