#include "../../../include/cub_bonus.h"

int check_door_orientation(char **map, int x, int y)
{
    if (y <= 0 || x <= 0)
        return 0;

    if (map[y - 1][x] == '1' && map[y + 1][x] == '1')
        return 1;
    if (map[y][x - 1] == '1' && map[y][x + 1] == '1')
        return 2;
    return 0;
}

 int hit_door(char **map, int map_x, int map_y)
{
    if (map_y < 0 || map_x < 0) 
        return 0;
    return (map[map_y][map_x] == 'D');
}

//texture-----------
void draw_column(t_game *game, int screen_x, int start , int end ,int tex_x)
{
	int texture_y;

    for (int y = start; y < end; y++)
	{
		texture_y = (y - start) * game->texture[0]->height / (end - start);
		int color = get_pixel_color(game->texture[1], tex_x, texture_y);
		mlx_put_pixel(game->img, screen_x, y, color);

	}
}
int is_vertical_or_horizontal_door_hit(float ray_x, float ray_y)
{
	int x = floorf(fmod(ray_x, TILE_SIZE));
	int y = floorf(fmod(ray_y, TILE_SIZE));
	if (x < y)
		return HORIZONTAL;
	else
		return VERTICAL;
}
//----------------

int cast_ray_collect_doors(t_game *game, float ray_angle, t_door_hit *hits)
{
    float ray_x = game->player.pos.x;
    float ray_y = game->player.pos.y;
    float dx = cosf(ray_angle);
    float dy = sinf(ray_angle);
    float distance = 0.0f;
    int hit_count = 0;

    while (1)
    {
        if (hit_count >= 255) 
            return hit_count;
        int map_x = (int)(ray_x / TILE_SIZE);
        int map_y = (int)(ray_y / TILE_SIZE);

        if (map_y < 0 || map_x < 0 || map_y >= game->minimap.map_h || map_x >= game->minimap.map_w ) 
            break;
        if ( game->map[map_y][map_x] == '1') 
            break;
        if (hit_door(game->map, map_x, map_y))
        {
                t_door *temp = game->ptrdoor;
                while (temp && (temp->x != map_x || temp->y != map_y))
                    temp = temp->next;
                if (!temp) 
                    break;
                int already_hit = 0;
            for (int i = 0; i < hit_count; i++)
            {
                if (hits[i].door == temp)
                {
                    already_hit = 1;
                    break;
                }
            }
            if (!already_hit)
            {
                hits[hit_count].door = temp;
                hits[hit_count].distance = distance * cosf(game->player.angle - ray_angle);
                hits[hit_count].orientation = check_door_orientation(game->map, map_x, map_y);
                hits[hit_count].ray_x = ray_x;
                hits[hit_count].ray_y = ray_y;
                hit_count++;
            }

                // hits[hit_count].door = temp;
                // hits[hit_count].distance = distance * cosf(game->player.angle - ray_angle);
                // hits[hit_count].orientation = check_door_orientation(game->map, map_x, map_y);
                // hits[hit_count].ray_x = ray_x;
                // hits[hit_count].ray_y = ray_y;
                // hit_count++;
        }
        ray_x += dx;
        ray_y += dy;
        distance += 0.32f;
    }

    return hit_count;
}


void draw_single_door_hit(t_game *game, t_door_hit *hit, int column)
{
    int column_height = (TILE_SIZE * 270) / hit->distance;
    float open_factor = 1.0f - hit->door->offset;
    int visible_height = (int)(column_height * open_factor);
    int shift_up = (int)(column_height * hit->door->offset / 2);
    int start = (HEIGHT / 2) - (column_height / 2) - shift_up;
    int end = start + visible_height;
    if (start < 0) start = 0;
    if (end >= HEIGHT) end = HEIGHT - 1;

    int texture_x;
    if (is_vertical_or_horizontal_door_hit(hit->ray_x, hit->ray_y) == VERTICAL)
        texture_x = (fmod(hit->ray_x, TILE_SIZE) * game->texture[0]->width) / TILE_SIZE;
    else
        texture_x = (fmod(hit->ray_y, TILE_SIZE) * game->texture[0]->width) / TILE_SIZE;

    float door_start_x;
    float door_end_x;
    float door_start_y;
    float door_end_y;
    float door_width = TILE_SIZE * 0.01f;

    if (hit->orientation == 2)
    {
        door_start_y = hit->door->y * TILE_SIZE;
        door_end_y = door_start_y + door_width;
        if (hit->ray_y >= door_start_y && hit->ray_y <= door_end_y)
            draw_column(game, column, start, end, texture_x);
    }
    else if (hit->orientation == 1)
    {
        door_start_x = hit->door->x * TILE_SIZE;
        door_end_x = door_start_x + door_width;
        if (hit->ray_x >= door_start_x && hit->ray_x <= door_end_x)
            draw_column(game, column, start, end, texture_x);
    }
}

void ft_raycast_doors(t_game *game)
{
    float fov_rad;
    float start_angle;
    int column;

    fov_rad = FOV * (M_PI / 180.0f);
    start_angle = game->player.angle - fov_rad / 2.0f;
    column = -1;
    while (++column < WIDTH)
    {
        float ray_angle = start_angle + (fov_rad / WIDTH) * column;
        t_door_hit hits[(int)WIDTH];
        int hit_count = cast_ray_collect_doors(game, ray_angle, hits);
        while (--hit_count >= 0)
        {
            draw_single_door_hit(game, &hits[hit_count], column);
        }
    }
}

